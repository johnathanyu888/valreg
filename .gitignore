# Virtual environment: rebuilt from requirements.txt, never committed
.venv/

# Secrets such as API keys: never committed
.env

# Python's compiled-code cache, regenerated automatically
__pycache__/

# SQLite database: generated by run_pipeline.py from data/raw/; the app reads data/results/ instead
data/valreg.db

# Kaggle VCT dataset: ~160 MB, too big for GitHub. Re-download it (see data/raw/README.md)
data/raw/kaggle_vct/
